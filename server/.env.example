# Living Pages server — copy to server/.env. The Gemini key lives ONLY here.
GEMINI_API_KEY=

# Models (verified 2026-11-14 at https://ai.google.dev/gemini-api/docs/models).
# Defaults are the stable Flash model for both stages.
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_CODE_MODEL=gemini-3.8-flash
# Measured on our 10 eval pages: page understanding takes 6–9 s on gemini-3.8-flash
# vs 2.2–3.2 s on gemini-3.5-flash-lite with the same figure decisions.
# Only Flash-Lite meets the "chime ≤ 4 s" target:
# GEMINI_VISION_MODEL=gemini-3.5-flash-lite
# Thinking level per stage: LOW | MEDIUM | HIGH (gemini-3.8-flash rejects MINIMAL)
GEMINI_VISION_THINKING=LOW
GEMINI_CODE_THINKING=LOW
# Longest side of the image sent for page understanding (px): details pass / fast pass before the chime
GEMINI_VISION_MAX_SIDE=1600
GEMINI_VISION_FAST_MAX_SIDE=1024
# If the vision model fails or times out, retry once on this model
GEMINI_VISION_FALLBACK_MODEL=gemini-3.8-flash
GEMINI_VISION_TIMEOUT_MS=15000
# Optional: a stronger model only for repair attempts after a failed validation
# (e.g. gemini-3.1-pro-preview). Empty = repairs use GEMINI_CODE_MODEL.
GEMINI_REPAIR_MODEL=
GEMINI_REPAIR_THINKING=MEDIUM

PORT=8787
# Public base URL the phone uses to reach this server (defaults to the request origin)
PUBLIC_URL=
CORS_ORIGINS=*

# Gating
BLUR_THRESHOLD=60          # Laplacian variance on a 512 px greyscale; below = blurry
SAME_FRAME_BITS=10         # dHash Hamming distance for "same page"
STABLE_FRAMES=2            # consecutive steady frames before calling Gemini
SETTLE_MAX_GAP_MS=4500     # frames further apart than this: one sharp frame is enough (slow photo delivery). Set very high to always wait.
VISUALIZABLE_THRESHOLD=0.75
MAX_REPAIRS=2
# Serve a reference example when the page shows exactly that system (instant)
TEMPLATE_MATCH=1
ALLOW_HTTP_PHOTOS=1
DATA_DIR=./data
